rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /planetas/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /consultas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['planetaId', 'fecha'])
                    && request.resource.data.planetaId is string;
      allow read, update, delete: if false;
    }
  }
}
